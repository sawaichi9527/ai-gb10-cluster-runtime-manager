# Secrets / machine-local config — never commit
config/cluster.env

# Runtime state markers (node paths) — not meaningful in git
# Nothing under state/ is ever committed: last-runtime / last-cluster-profile,
# background-boot markers (boot-cluster.*.pid, boot-ready.*, boot-single.*.pid),
# kit launcher markers (kit.*.pid, kit.*.rc). git only keeps the dir via the
# code that mkdir -p's it.
state/

# Logs / transient
*.log
/tmp/
__pycache__/
*.pyc

# Profile/config backups (pre-upgrade snapshots) - never commit
cluster-profiles.d/*.bak-*
runtimes.d/*.bak-*

# qwen38flash generated artifacts (produced by patches/qwen38flash/prepare.sh
# from the local checkpoint; regenerate, do not commit)
patches/qwen38flash/config_patched.json
patches/qwen38flash/hf_quant_config_patched.json
