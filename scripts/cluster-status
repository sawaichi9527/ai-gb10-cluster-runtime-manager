#!/usr/bin/env bash
# =====================================================================
# cluster-status — show both node containers, TP/RDMA, KV caps and health.
# =====================================================================
set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/cluster-common.sh"

# ---------------------------------------------------------------------
# Collect container / image / model / health facts (read-only) for a
# compact TP2 summary printed before the per-node detail blocks.
# Node0 docker runs without sudo (eye is in the docker group); Node1 is
# reached over the interconnect ssh (n1).
# ---------------------------------------------------------------------

# --- Node0 container present + running ---
NODE0_UP="down"
if docker ps -a --filter name=cluster-node0 --format '{{.Names}}' 2>/dev/null | grep -q '^cluster-node0$'; then
  if docker ps --filter name=cluster-node0 --filter status=running --format '{{.Names}}' 2>/dev/null | grep -q '^cluster-node0$'; then
    NODE0_UP="up"
  fi
fi

# --- Node0 image / model mounts (only meaningful when up) ---
NODE0_IMG=""
NODE0_BODY=""
NODE0_DRAF=""
if [[ "${NODE0_UP}" == "up" ]]; then
  NODE0_IMG=$(docker inspect cluster-node0 --format '{{.Config.Image}}' 2>/dev/null || true)
  NODE0_BODY=$(docker inspect cluster-node0 --format '{{range .Mounts}}{{println .Source "=>" .Destination}}{{end}}' 2>/dev/null \
      | awk '$3=="/model"{n=split($1,a,"/"); print a[n]}' || true)
  NODE0_DRAF=$(docker inspect cluster-node0 --format '{{range .Mounts}}{{println .Source "=>" .Destination}}{{end}}' 2>/dev/null \
      | awk '$3=="/drafter"{n=split($1,a,"/"); print a[n]}' || true)
fi

# --- Node0 KV / world size from the vLLM log (short lines only) ---
KV_LINE=""
WORLD=""
if [[ "${NODE0_UP}" == "up" ]]; then
  KV_LINE=$(docker logs cluster-node0 2>/dev/null | grep -a "Available KV cache memory" | tail -1 || true)
  WORLD=$(docker logs cluster-node0 2>/dev/null | grep -aoE 'world_size=[0-9]+' | head -1 || true)
fi
KV_VAL=""
if [[ -n "${KV_LINE:-}" ]]; then
  KV_VAL=$(printf '%s' "$KV_LINE" | sed -E 's/.*Available KV cache memory: ([0-9.]+ [A-Za-z]+).*/\1/')
fi

# --- Node1 container status over ssh ---
NODE1_STATUS=""
NODE1_UP="down"
if n1 true 2>/dev/null; then
  NODE1_STATUS=$(n1 bash -s <<'EOF'
docker ps -a --filter name=cluster-node1 --format '{{.Names}} {{.Status}}' 2>/dev/null | head -1 || true
EOF
)
fi
if [[ -n "${NODE1_STATUS:-}" ]]; then
  case "${NODE1_STATUS}" in
    *" Up "*) NODE1_UP="up" ;;
  esac
fi

# --- API health + aggregate summary state ---
HEALTH="not ready"
if curl -fsS -m 5 "http://localhost:${API_PORT}/health" >/dev/null 2>&1; then
  HEALTH="ready"
fi
STATUS="down"
if [[ "${NODE0_UP}" == "up" ]]; then
  STATUS="loading"
  [[ "${HEALTH}" == "ready" ]] && STATUS="ready"
fi

# ---------------------------------------------------------------------
# Summary block (before the per-node detail sections)
# ---------------------------------------------------------------------
echo ""
echo ""
echo ""
echo "TP2 cluster summary"
echo ""
echo "  status:  ${STATUS}"
echo "  node:    node0 ${NODE0_UP} · node1 ${NODE1_UP}"
if [[ "${NODE0_UP}" == "up" ]]; then
  echo "  image:   ${NODE0_IMG:-<unknown>}"
  echo "  model:   ${NODE0_BODY:-<none>}"
  [[ -n "${NODE0_DRAF:-}" ]] && echo "  drafter: ${NODE0_DRAF}"
  if [[ -n "${WORLD:-}" ]]; then
    echo "  world:   ${WORLD#world_size=} GPUs (TP2)"
  fi
  [[ -n "${KV_VAL:-}" ]] && echo "  kv:      ${KV_VAL} (node0)"
fi
echo "  api:     http://${NODE0_MGMT}:${API_PORT}/v1 · health ${HEALTH}"
if [[ "${STATUS}" != "ready" && "${HEALTH}" == "ready" ]]; then
  echo "  note:    :${API_PORT} answers but no TP2 container is up — another runtime may be serving (check gb10-single / docker ps)"
fi

echo ""
echo ""
echo ""

echo "===== Node0 ($(hostname)) ====="
sdk docker ps -a --filter name=cluster-node0 --format '{{.Names}} {{.Status}}' 2>/dev/null
echo "-- RDMA/NET lines from node0 boot --"
# vLLM logs live in `docker logs cluster-node0` (the docker-run stdout file only
# holds the container hash for a detached run).
sdk docker logs cluster-node0 2>/dev/null | grep -aE "NET/IB|Using network|NET/Socket|using RDMA|IB devices" | head -5 || true
echo "-- KV / world size from node0 log --"
# vLLM prints its engine config as giant single-line dicts; those lines carry
# 'model' (quoted) and would flood the report. Drop them and show only the
# short status lines (parallel_state membership + Available KV cache).
sdk docker logs cluster-node0 2>/dev/null | grep -aiE "Available KV cache|world_size=[0-9]+ rank=[0-9]+|node_rank=[0-9]+" | grep -av "'model'" | tail -8 || true

echo ""
echo "===== Node1 (${NODE1_SSH_USER}@${NODE1_IP}) ====="
printf '%s\n' "${NODE1_STATUS:-}"

echo ""
echo "===== API health :${API_PORT} ====="
echo "health: ${HEALTH}"
echo "===== API endpoint ====="
echo "http://${NODE0_MGMT}:${API_PORT}/v1  (auth: $([[ -n "${VLLM_API_KEY:-}" && "${VLLM_API_KEY}" != "EMPTY" ]] && echo "[REDACTED:bearer-auth:10] set" || echo "disabled"))"
echo "===== /v1/models ====="
api_curl "http://localhost:${API_PORT}/v1/models" -m 5 2>/dev/null | head -c 300 || echo "(no models)"
echo ""
echo ""
echo ""
echo ""
