#!/usr/bin/env bash
# =====================================================================
# cluster-load — real cross-node concurrent load: 8-way x 3 rounds.
# =====================================================================
set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/cluster-common.sh"

ROUNDS="${LOAD_ROUNDS:-3}"
WORKERS="${LOAD_WORKERS:-8}"

# Model id of the lane selected last (compose lanes: aeon; kit lanes: their own).
_ACTIVE="$(cat "${REPO_DIR}/state/last-cluster-profile" 2>/dev/null || true)"
if [[ -n "${_ACTIVE}" && -f "${PROFILE_DIR}/${_ACTIVE}.conf" ]]; then
  load_profile "${_ACTIVE}" >/dev/null 2>&1 || true
fi
MODEL_ID="${SERVED_MODEL:-aeon}"

python3 - "$API_PORT" "$ROUNDS" "$WORKERS" "${VLLM_API_KEY:-}" "$MODEL_ID" <<'PY'
import json, sys, urllib.request, concurrent.futures, time
port, rounds, workers = int(sys.argv[1]), int(sys.argv[2]), int(sys.argv[3])
api_key = sys.argv[4] if len(sys.argv) > 4 and sys.argv[4] and sys.argv[4] != "EMPTY" else ""
model_id = sys.argv[5] if len(sys.argv) > 5 and sys.argv[5] else "aeon"
URL = f"http://localhost:{port}/v1/chat/completions"

def mkreq(i):
    body = json.dumps({
        "model": model_id,
        "messages": [{"role": "user", "content": f"Count from 1 to 10 (round {i})."}],
        "max_tokens": 80, "temperature": 0.7,
    }).encode()
    hdrs = {"Content-Type": "application/json"}
    if api_key:
        hdrs["Authorization"] = f"Bearer {api_key}"
    return urllib.request.Request(URL, data=body, headers=hdrs)

def req(i):
    r = mkreq(i)
    t0 = time.time()
    d = json.load(urllib.request.urlopen(r, timeout=120))
    dt = time.time() - t0
    u = d["usage"]
    return u["prompt_tokens"], u["completion_tokens"], dt, d.get("model")

with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as ex:
    for rnd in range(rounds):
        t0 = time.time()
        futs = [ex.submit(req, i + rnd * workers) for i in range(workers)]
        res = [f.result() for f in futs]
        wall = time.time() - t0
        pt = sum(r[0] for r in res); ct = sum(r[1] for r in res); dt = sum(r[2] for r in res)
        print(f"round {rnd+1}: wall={wall:.2f}s prompt_tok={pt} comp_tok={ct} model={res[0][3]}")
print("load DONE")
PY
