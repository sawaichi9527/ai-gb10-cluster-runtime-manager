#!/usr/bin/env bash
# =====================================================================
# tp2-status — show both node containers, TP/RDMA, KV caps and health.
# =====================================================================
set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/tp2-common.sh"

echo "===== Node0 ($(hostname)) ====="
sdk docker ps -a --filter name=tp2-node0 --format '{{.Names}} {{.Status}}' 2>/dev/null
echo "-- RDMA/NET lines from node0 boot --"
# vLLM logs live in `docker logs tp2-node0` (the docker-run stdout file only
# holds the container hash for a detached run).
sdk docker logs tp2-node0 2>/dev/null | grep -aE "NET/IB|Using network|NET/Socket|using RDMA|IB devices" | head -5 || true
echo "-- KV / world size from node0 log --"
# vLLM prints its engine config as giant single-line dicts; those lines carry
# 'model' (quoted) and would flood the report. Drop them and show only the
# short status lines (parallel_state membership + Available KV cache).
sdk docker logs tp2-node0 2>/dev/null | grep -aiE "Available KV cache|world_size=[0-9]+ rank=[0-9]+|node_rank=[0-9]+" | grep -av "'model'" | tail -8 || true

echo ""
echo "===== Node1 (${NODE1_SSH_USER}@${NODE1_IP}) ====="
n1 bash -s <<EOF
$(printf 'export SUDO_PASS=%q\n' "${SUDO_PASS}")
echo "\$SUDO_PASS" | sudo -S docker ps -a --filter name=tp2-node1 --format '{{.Names}} {{.Status}}' 2>/dev/null || true
EOF

echo ""
echo "===== API health :${API_PORT} ====="
if curl -fsS -m 5 "http://localhost:${API_PORT}/health" >/dev/null 2>&1; then
  echo "health: READY"
else
  echo "health: (not ready / down)"
fi
echo "===== API endpoint ====="
echo "http://${NODE0_MGMT}:${API_PORT}/v1  (auth: $([[ -n "${VLLM_API_KEY:-}" && "${VLLM_API_KEY}" != "EMPTY" ]] && echo "Bearer key set" || echo "disabled"))"
echo "===== /v1/models ====="
api_curl "http://localhost:${API_PORT}/v1/models" -m 5 2>/dev/null | head -c 300 || echo "(no models)"
echo ""
