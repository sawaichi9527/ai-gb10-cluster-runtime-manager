#!/usr/bin/env bash
# =====================================================================
# tp2-up — bring up the 2-node (TP2) cluster from Node0 only.
#
#   scripts/tp2-up            # 27B (default)
#   scripts/tp2-up 35b        # 35B-A3B
#
# Flow (Node0 single-side orchestration):
#   1. resolve profile params (shared, verified 2026-08-30)
#   2. Node0 -> ssh -> Node1 : launch headless rank1 worker
#   3. Node0                     launch API server rank0 (port API_PORT)
#   4. wait for Node0 /health 200
# =====================================================================
set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/tp2-common.sh"

PROFILE_ARG="${1:-27b}"
set_profile "${PROFILE_ARG}"

node_up

# ------------------------------------------------------------------
# Node1 headless worker (rank1). Param values are computed here on
# Node0 and passed to Node1 via environment over ssh — Node1 does NOT
# need the repo or tp2-common.sh.
# ------------------------------------------------------------------
REMOTE=$(cat <<'RSCRIPT'
set -Eeuo pipefail
echo "$SUDO_PASS" | sudo -S docker rm -f tp2-node1 >/dev/null 2>&1 || true
echo "$SUDO_PASS" | sudo -S docker run -d --name tp2-node1 \
    --gpus all --ipc=host --shm-size=16g --net=host \
    -e "VLLM_HOST_IP=${RHOST_IP}" \
    -e "NCCL_SOCKET_IFNAME=${R_NCCL_SOCKET_IFNAME}" \
    -e "GLOO_SOCKET_IFNAME=${R_NCCL_SOCKET_IFNAME}" \
    -e "NCCL_IB_HCA=${R_IB_HCA}" \
    -e "NCCL_IB_GID_INDEX=${R_IB_GID}" \
    -e "PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True" \
    --device /dev/infiniband --cap-add IPC_LOCK --ulimit memlock=-1:-1 \
    -v "${R_BODY}:/model:ro" \
    -v "${R_DRAF}:/drafter:ro" \
    --entrypoint vllm "${R_IMG}" serve /model \
        --served-model-name aeon \
        --headless \
        --tensor-parallel-size 2 --nnodes 2 --node-rank 1 \
        --master-addr "${R_MASTER_ADDR}" --master-port "${R_MASTER_PORT}" \
        --quantization compressed-tensors --kv-cache-dtype fp8_e4m3 \
        --attention-backend TRITON_ATTN \
        --max-model-len "${R_MAXLEN}" --max-num-seqs "${R_NUMSEQ}" \
        --max-num-batched-tokens "${R_BATCHED}" \
        --gpu-memory-utilization "${R_GMU}" \
        --disable-custom-all-reduce \
        --enable-chunked-prefill --no-enable-prefix-caching \
        --compilation-config '{"cudagraph_mode":"FULL_AND_PIECEWISE"}' \
        --speculative-config "{\"method\":\"dflash\",\"model\":\"/drafter\",\"num_speculative_tokens\":${R_NSPEC},\"attention_backend\":\"TRITON_ATTN\"}" \
        --trust-remote-code \
    > /tmp/tp2-node1.log 2>&1
rc=$?
echo "DEBUG node1 docker run rc=$rc"
echo "$SUDO_PASS" | sudo -S docker ps --filter name=tp2-node1 --format '{{.Names}} {{.Status}}' 2>/dev/null || true
exit 0
RSCRIPT
)

echo "== launching Node1 headless worker (rank1, profile=${PROFILE}) =="
n1 bash -s <<EOF
$(printf 'export SUDO_PASS=%q\n' "${SUDO_PASS}")
export RHOST_IP='${NODE1_IP}'
export R_NCCL_SOCKET_IFNAME='${NCCL_SOCKET_IFNAME}'
export R_IB_HCA='${NODE1_IB_HCA:-${NCCL_IB_HCA}}'
export R_IB_GID='${NODE1_IB_GID_INDEX:-${NCCL_IB_GID_INDEX}}'
export R_BODY='${BODY}'
export R_DRAF='${DRAF}'
export R_IMG='${IMG}'
export R_MASTER_ADDR='${MASTER_ADDR}'
export R_MASTER_PORT='${MASTER_PORT}'
export R_MAXLEN='${MAXLEN}'
export R_NUMSEQ='${NUMSEQ}'
export R_BATCHED='${BATCHED}'
export R_GMU='${GMU}'
export R_NSPEC='${NSPEC}'
${REMOTE}
EOF

# ------------------------------------------------------------------
# Node0 API server (rank0)
# ------------------------------------------------------------------
build_docker_env 0
build_vllm_args 0
echo "== launching Node0 API server (rank0, profile=${PROFILE}) =="
sdk docker rm -f tp2-node0 >/dev/null 2>&1 || true
# shellcheck disable=SC2145
sdk docker run -d --name tp2-node0 \
    --gpus all --ipc=host --shm-size=16g --net=host \
    "${DOCKER_ENV_EXTRA[@]}" \
    --device /dev/infiniband --cap-add IPC_LOCK --ulimit memlock=-1:-1 \
    "${DOCKER_MOUNTS[@]}" \
    --entrypoint vllm "${IMG}" serve /model \
    "${VLLM_ARGS[@]}" \
    > /tmp/tp2-node0.log 2>&1
echo "node0 docker run rc=$?"

# ------------------------------------------------------------------
# wait for health
# ------------------------------------------------------------------
echo "== waiting for API health on :${API_PORT} (cold start can take ~10-15 min) =="
begin=$SECONDS
until curl -fsS -m 5 "http://localhost:${API_PORT}/health" >/dev/null 2>&1; do
  if ((SECONDS-begin > 2400)); then
    echo "ERROR: health timeout (2400s)" >&2
    sdk docker logs --tail 60 tp2-node0 2>&1 || true
    exit 1
  fi
  sleep 10
done
echo "$(date '+%F %T') TP2 profile=${PROFILE} READY on :${API_PORT}"
sdk docker ps --filter name=tp2-node --format '{{.Names}} {{.Status}}' 2>/dev/null || true
