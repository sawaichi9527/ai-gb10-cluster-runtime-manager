#!/usr/bin/env bash
# =====================================================================
# tp2-down — stop & remove the TP2 cluster containers on BOTH nodes.
# =====================================================================
set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/tp2-common.sh"

echo "== stopping Node1 (headless) =="
n1 bash -s <<EOF
$(printf 'export SUDO_PASS=%q\n' "${SUDO_PASS}")
echo "\$SUDO_PASS" | sudo -S docker rm -f tp2-node1 >/dev/null 2>&1 || true
echo "\$SUDO_PASS" | sudo -S docker ps -a --filter name=tp2-node1 --format '{{.Names}} {{.Status}}' 2>/dev/null || true
exit 0
EOF

echo "== stopping Node0 (API) =="
sdk docker rm -f tp2-node0 >/dev/null 2>&1 || true
sdk docker ps -a --filter name=tp2-node0 --format '{{.Names}} {{.Status}}' 2>/dev/null || true

echo "TP2 down complete."
