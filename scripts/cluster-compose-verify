#!/usr/bin/env bash
# =====================================================================
# cluster-compose-verify [profile] - M2 composition-parity gate.
#
# Compares the LIVE compose-launched TP2 containers (cluster-node0 /
# cluster-node1) field-by-field against the resolved profile spec (the
# shared build_vllm_args / build_docker_env builders plus the profile-owned
# CAP_ADD / ULIMITS extras are the single source of truth). Run after
# a compose cold start is READY:
#     scripts/cluster-compose-verify deepseek
#
# Per rank verifies:
#   entrypoint, command (JSON-exact), per-key env (expected keys),
#   bind mounts (Source;Destination;RW), network/ipc mode, shm size,
#   /dev/infiniband device, cap_add set (IPC_LOCK + CAP_ADD), ulimit set
#   (memlock/stack + ULIMITS), nvidia DeviceRequests (driver/count/capabilities).
# Exits non-zero with a concise diff line on the first mismatch.
# =====================================================================
set -Eeuo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=cluster-common.sh
source "${REPO_DIR}/scripts/cluster-common.sh"

PROFILE="${1:-deepseek}"
load_profile "${PROFILE}"

if [[ "${PROFILE_PLACEHOLDER:-false}" == "true" ]]; then
  echo "INFO: profile ${PROFILE} is not deployed yet (placeholder); nothing to verify." >&2
  exit 0
fi

if [[ "${LAUNCH_STYLE:-compose}" != "compose" ]]; then
  echo "INFO: profile ${PROFILE} is not LAUNCH_STYLE=compose; nothing to verify." >&2
  exit 0
fi

# ---- helpers --------------------------------------------------------
json_esc(){ local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '%s' "$s"; }

shm_bytes(){ # "64g"/"16g"/N -> bytes
  local v="${SHM_SIZE:-16g}"
  case "$v" in
    *g) echo $(( ${v%g} * 1024 * 1024 * 1024 )) ;;
    *m) echo $(( ${v%m} * 1024 * 1024 )) ;;
    *)  echo "$v" ;;
  esac
}

# Expected entrypoint. The CMD_WRAPPER path emits `entrypoint: []` and runs
# `bash -lc "<wrapper>; exec vllm serve ..."` instead (see _compose_service).
exp_entry_json(){
  if [[ -n "${CMD_WRAPPER:-}" ]]; then printf '[]'; return; fi
  [[ "${ENGINE}" == "sglang" ]] && printf '["sglang"]' || printf '["vllm"]'
}

exp_cmd_json(){ # rank -> JSON array matching _compose_service's `command:`
  local r="$1" a first=1
  local -a A
  if [[ "${ENGINE}" == "sglang" ]]; then build_sglang_args "$r"; A=( "${SGLANG_ARGS[@]}" )
  else build_vllm_args "$r"; A=( "${VLLM_ARGS[@]}" ); fi
  if [[ -n "${CMD_WRAPPER:-}" ]]; then
    local s="${CMD_WRAPPER}; exec /usr/local/bin/vllm serve /model"
    for a in "${A[@]}"; do s+=" $(printf '%q' "$a")"; done
    # elements only; the caller wraps them in [...]
    printf '"bash","-lc","%s"' "$(json_esc "$s")"
    return
  fi
  set -- "serve" "/model" "${A[@]}"
  for a in "$@"; do
    (( first )) || printf ','
    first=0
    printf '"%s"' "$(json_esc "$a")"
  done
}

exp_env_map(){ # rank -> "KEY=VAL" lines for the expected extra env (rank-specific)
  local r="$1" tok i=0
  build_docker_env "$r"
  while (( i < ${#DOCKER_ENV_EXTRA[@]} )); do
    tok="${DOCKER_ENV_EXTRA[i]}"
    if [[ "$tok" == "-e" ]]; then tok="${DOCKER_ENV_EXTRA[$((i+1))]}"; (( i+=2 ))
    else (( i+=1 )); fi
    [[ "$tok" == *=* ]] && echo "${tok%%=*}=${tok#*=}"
  done
}

exp_mnt_lines(){ # rank -> "SRC;DEST;true|false" lines (Source;Destination;RW)
  local r="$1" tok m dst i=0
  build_docker_env "$r"
  while (( i < ${#DOCKER_MOUNTS[@]} )); do
    tok="${DOCKER_MOUNTS[i]}"
    if [[ "$tok" == "-v" ]]; then m="${DOCKER_MOUNTS[$((i+1))]}"; (( i+=2 ))
    elif [[ "$tok" == "-v "* ]]; then m="${tok#-v }"; (( i+=1 ))
    else (( i+=1 )); continue; fi
    if [[ "$m" == *":ro" ]]; then
      dst="${m#*:}"; dst="${dst%:ro}"
      echo "${m%%:*};${dst};false"
    elif [[ "$m" == *":"* ]]; then
      echo "${m%%:*};${m#*:};true"
    else
      echo "${m};${m};true"
    fi
  done
}

# scalar fact template (separator-delimited, then parsed on the separator).
# The separator MUST NOT appear in any field: a CMD_WRAPPER command contains
# `||` (from `|| exit 1`), so `||` cannot be used here.
CVSEP='@@CVSEP@@'
TM_SCALARS="{{json .Config.Entrypoint}}${CVSEP}{{json .Config.Cmd}}${CVSEP}{{.HostConfig.NetworkMode}}${CVSEP}{{.HostConfig.IpcMode}}${CVSEP}{{.HostConfig.ShmSize}}${CVSEP}{{join .HostConfig.Devices \"|\"}}${CVSEP}{{join .HostConfig.CapAdd \"|\"}}${CVSEP}{{range .HostConfig.Ulimits}}{{.Name}}={{.Soft}}={{.Hard}};{{end}}${CVSEP}{{range .HostConfig.DeviceRequests}}[{{.Driver}}|{{.Count}}|{{join .Capabilities \",\"}}];{{end}}"

get_facts(){ # <rank> -> sets GET_* and NODE_HOME ; 0 runs locally, 1 over n1 (sudo)
  local rank="$1"
  local cid="cluster-node${rank}" out SP
  if [[ "$rank" == "0" ]]; then
    NODE_HOME="$HOME"
    GET_ENV="$(sdk docker inspect "$cid" --format '{{range .Config.Env}}{{println .}}{{end}}')"
    GET_MNT="$(sdk docker inspect "$cid" --format '{{range .Mounts}}{{.Source}};{{.Destination}};{{.RW}}{{println}}{{end}}')"
    out="$(sdk docker inspect "$cid" --format "$TM_SCALARS")"
  else
    SP="$(printf '%q' "$(sudo_pass)")"
    NODE_HOME="$(n1 'echo "$HOME"')"
    GET_ENV="$(n1 "export SUDO_PASS=${SP}; echo \"\$SUDO_PASS\" | sudo -S docker inspect $cid --format '{{range .Config.Env}}{{println .}}{{end}}'")"
    GET_MNT="$(n1 "export SUDO_PASS=${SP}; echo \"\$SUDO_PASS\" | sudo -S docker inspect $cid --format '{{range .Mounts}}{{.Source}};{{.Destination}};{{.RW}}{{println}}{{end}}'")"
    out="$(n1 "export SUDO_PASS=${SP}; echo \"\$SUDO_PASS\" | sudo -S docker inspect $cid --format '$TM_SCALARS'")"
  fi
  # scalars split on CVSEP: entry cmd net ipc shm dev cap ul dr
  GET_ENTRY="${out%%${CVSEP}*}"
  rest="${out#*${CVSEP}}"; GET_CMD="${rest%%${CVSEP}*}"; rest="${rest#*${CVSEP}}"
  GET_NET="${rest%%${CVSEP}*}"; rest="${rest#*${CVSEP}}"; GET_IPC="${rest%%${CVSEP}*}"; rest="${rest#*${CVSEP}}"
  GET_SHM="${rest%%${CVSEP}*}"; rest="${rest#*${CVSEP}}"; GET_DEV="${rest%%${CVSEP}*}"; rest="${rest#*${CVSEP}}"
  GET_CAP="${rest%%${CVSEP}*}"; rest="${rest#*${CVSEP}}"; GET_UL="${rest%%${CVSEP}*}"; rest="${rest#*${CVSEP}}"
  GET_DR="$rest"
}

fail=0
verify_rank(){ # 0 | 1
  local rank="$1" rfail=0
  local label="cluster-node${rank}" kv
  local got_ul exp_ul got_cap exp_cap
  get_facts "$rank"
  exp_env_map   "$rank"     > "/tmp/cv-exp-env.$$"
  exp_mnt_lines "$rank"     > "/tmp/cv-exp-mnt.$$"
  printf '%s\n' "$GET_ENV"  > "/tmp/cv-got-env.$$"
  printf '%s\n' "$GET_MNT"  > "/tmp/cv-got-mnt.$$"
  sort -o "/tmp/cv-exp-mnt.$$"  "/tmp/cv-exp-mnt.$$"
  sort -o "/tmp/cv-got-mnt.$$"  "/tmp/cv-got-mnt.$$"
  sed -i "s|^~|${NODE_HOME}|" "/tmp/cv-exp-mnt.$$"

  check(){ local cond="$1" msg="$2"; if [[ "$cond" != "OK" ]]; then echo "FAIL ${label}: ${msg}"; fail=1; rfail=1; fi; }

  check "$( [[ "$GET_ENTRY" == "$(exp_entry_json)" ]] && echo OK || echo BAD )" "entrypoint ${GET_ENTRY} != $(exp_entry_json)"
  check "$( [[ "$GET_CMD" == "[$(exp_cmd_json "$rank")]" ]] && echo OK || echo BAD )" "command mismatch (got ${GET_CMD})"
  while IFS= read -r kv; do
    [[ -n "$kv" ]] || continue
    grep -qFx "$kv" "/tmp/cv-got-env.$$" \
      || { echo "FAIL ${label}: env missing ${kv}"; fail=1; rfail=1; }
  done < "/tmp/cv-exp-env.$$"
  if ! diff -q "/tmp/cv-exp-mnt.$$" "/tmp/cv-got-mnt.$$" >/dev/null; then
    echo "FAIL ${label}: mounts differ"; diff -u "/tmp/cv-exp-mnt.$$" "/tmp/cv-got-mnt.$$" || true; fail=1; rfail=1
  fi
  check "$( [[ "$GET_NET" == "host" ]] && echo OK || echo BAD )" "NetworkMode ${GET_NET} != host"
  check "$( [[ "$GET_IPC" == "host" ]] && echo OK || echo BAD )" "IpcMode ${GET_IPC} != host"
  check "$( [[ "$GET_SHM" == "$(shm_bytes)" ]] && echo OK || echo BAD )" "ShmSize ${GET_SHM} != $(shm_bytes)"
  # Devices: current docker renders DeviceMapping as "{PathOnHost PathInContainer CgroupPermissions}"
  check "$( [[ "$GET_DEV" == *"/dev/infiniband /dev/infiniband rwm"* ]] && echo OK || echo BAD )" "Devices ${GET_DEV}"
  # CapAdd: docker normalizes with CAP_ prefix; compare as a sorted set so the
  # profile-owned CAP_ADD extras (e.g. SYS_NICE) are included.
  got_cap="$(printf '%s' "$GET_CAP" | tr '|' '\n' | sed '/^$/d' | sort | tr '\n' ' ')"
  exp_cap="$(
    { printf '%s\n' "CAP_IPC_LOCK"
      if [[ -n "${CAP_ADD+x}" ]]; then
        for _c in "${CAP_ADD[@]}"; do [[ -n "$_c" ]] && printf 'CAP_%s\n' "$_c"; done
      fi
    } | sort | tr '\n' ' ')"
  check "$( [[ "$got_cap" == "$exp_cap" ]] && echo OK || echo BAD )" "CapAdd ${GET_CAP} != ${exp_cap}"
  # ulimits: compare as sorted set; split on ';' first so sort reorders tokens.
  # Includes the profile-owned ULIMITS extras (e.g. nofile=1048576).
  got_ul="$(printf '%s' "$GET_UL" | tr ';' '\n' | sed '/^$/d' | sort | tr '\n' ' ')"
  exp_ul="$(
    { printf '%s\n' "memlock=-1=-1" "stack=67108864=67108864"
      if [[ -n "${ULIMITS+x}" ]]; then
        for _u in "${ULIMITS[@]}"; do
          _un="${_u%%=*}"; _uv="${_u#*=}"; printf '%s=%s=%s\n' "$_un" "$_uv" "$_uv"
        done
      fi
    } | sort | tr '\n' ' ')"
  check "$( [[ "$got_ul" == "$exp_ul" ]] && echo OK || echo BAD )" "Ulimits ${GET_UL}"
  if [[ "$GET_DR" == '[nvidia|-1|'* || "$GET_DR" == '[nvidia|0|'* ]]; then
    [[ "$GET_DR" == *gpu* ]] || check BAD "DeviceRequests ${GET_DR}"
  else
    check BAD "DeviceRequests ${GET_DR}"
  fi
  if (( rfail == 0 )); then echo "PASS ${label} (compose spec == profile spec)"; fi
}

verify_rank 0
verify_rank 1
rm -f "/tmp/cv-exp-env.$$" "/tmp/cv-exp-mnt.$$" "/tmp/cv-got-env.$$" "/tmp/cv-got-mnt.$$"

if (( fail )); then
  echo "compose-verify: FAILED (see diff lines above)" >&2
  exit 1
fi
echo "compose-verify: OK — profile=${PROFILE} compose parity holds on both ranks"