#!/usr/bin/env bash
# =====================================================================
# gb10-boot-cluster — background boot job for bin/gb10 use/start.
#
# Runs the full cluster-down → free_singles → cluster-up sequence in
# the background.  Called via setsid nohup from bin/gb10 (not directly).
#
#   gb10-boot-cluster <profile> [--skip-down]
#
# --skip-down is passed by `gb10 restart`, which has already stopped the
# stack synchronously (see the comment at the cluster-down call below).
#
# State files (all in ${REPO_DIR}/state/, gitignored):
#   boot-cluster.<PROFILE>.pid  — running PID (removed on exit)
#   boot-ready.<PROFILE>        — written on READY; read by gb10 wait/status
# =====================================================================
set -Eeuo pipefail

PROFILE="${1:?usage: gb10-boot-cluster <profile>}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Preflight: fail fast before the teardown/launch sequence when the
# checkout has drifted from upstream.  The background job logs the
# refusal; gb10 wait/status surface the boot error.
"${REPO_DIR}/scripts/check-git-sync.sh" --block

PID_FILE="${REPO_DIR}/state/boot-cluster.${PROFILE}.pid"
READY_FILE="${REPO_DIR}/state/boot-ready.${PROFILE}"

cleanup(){ rm -f "${PID_FILE}"; }
trap cleanup EXIT

mkdir -p "${REPO_DIR}/state"
echo "$$" > "${PID_FILE}"
rm -f "${READY_FILE}"

echo "$(date '+%F %T') [boot-cluster] background boot started: profile=${PROFILE}"

# --- cluster-down (stop existing TP2) ---
# `gb10 restart` already ran cluster-down synchronously before launching this
# job and passes --skip-down, so the kit lane is not stopped twice: the second
# stop used to race the first one's container teardown ("No such container",
# and on a bad day a relaunch into a name that was still in use).
# `use`/`start` keep the full teardown.
if [[ "${2:-}" == "--skip-down" ]]; then
  echo "$(date '+%F %T') [boot-cluster] cluster-down skipped (caller already stopped the stack)"
else
  "${REPO_DIR}/scripts/cluster-down"
fi

# --- free singles on both nodes (TP2 occupies both, shares port 1234) ---
for _n in node0 node1; do
  "${REPO_DIR}/bin/gb10-single" free "$_n"
done

# --- cluster-up (checksum + launch + health wait) ---
"${REPO_DIR}/scripts/cluster-up" "${PROFILE}"

# --- mark ready (consumed by gb10 wait / gb10 status) ---
echo "$(date '+%F %T') [boot-cluster] profile=${PROFILE} READY" | tee "${READY_FILE}"

echo "$(date '+%F %T') [boot-cluster] boot complete: profile=${PROFILE}"
