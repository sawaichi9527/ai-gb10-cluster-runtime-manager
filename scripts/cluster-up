#!/usr/bin/env bash
# =====================================================================
# cluster-up — bring up the 2-node (TP2) cluster from Node0 only.
#
#   scripts/cluster-up            # 27B (default)
#   scripts/cluster-up 35b        # 35B-A3B
#   scripts/cluster-up deepseek   # deepseek fp8 DSpark mainline
#
# Flow (Node0 single-side orchestration):
#   1. resolve cluster profile from cluster-profiles.d/<id>.conf
#   2. Node0 (sole argv builder) renders a docker-compose.yml for BOTH
#      ranks from the SAME profile data (build_vllm_args/build_docker_env).
#      Node1 receives the rendered file and runs `compose up -d worker`;
#      Node0 runs `compose up -d head`.
#   3. wait for Node0 /health 200.
# =====================================================================
set -Eeuo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/cluster-common.sh"

# Preflight: refuse to deploy from a checkout that has drifted from
# upstream.  Self-contained subprocess; exits 1 when behind/diverged.
# (bin/gb10 already gates the foreground path; this is the second line
# for direct invocations of this script.)
"${SCRIPT_DIR}/check-git-sync.sh" --block

PROFILE_ARG="${1:-27b}"
load_profile "${PROFILE_ARG}"

# Placeholder must fail safely: never start containers, never touch a
# missing stack/model/image.
if [[ "${PROFILE_PLACEHOLDER}" == "true" ]]; then
  echo "profile '${PROFILE}' not deployed yet (placeholder)"
  exit 0
fi

node_up

# Per-profile image manifest gate (opt-in: deepseek pins IMG_SHA256; 27b/35b skip).
# Fail-fast before any container is launched.
verify_profile_image_gate

# The FlashInfer autotune cache is rank-keyed and cannot be shared across
# ranks; leaving one behind deadlocks the boot (see cluster-common.sh).
# Reset both nodes so the two ranks tune in lockstep.
ensure_autotune_cache_reset

# ------------------------------------------------------------------
# Launch mechanism: compose (the unified lane). The compose file is
# rendered per launch from the same profile data as build_vllm_args /
# build_docker_env, so the container spec stays data-driven (zero drift).
# ------------------------------------------------------------------
ENTRY="vllm"; [[ "${ENGINE}" == "sglang" ]] && ENTRY="sglang"

# Materialize the render into the profile's node-local stack dir when it
# declares one (mirrors runtimes.d STACK_DIR + COMPOSE_FILE); otherwise keep
# the previous temporary-file behaviour. The materialized file is a generated
# artifact (re-rendered every launch => no drift) and is left on disk so it
# can be inspected.
if [[ -n "${STACK_DIR:-}" ]]; then
  mkdir -p "${STACK_DIR}"
  RENDER_YML="${COMPOSE_FILE}"
else
  RENDER_YML="$(mktemp)"
  trap 'rm -f -- "${RENDER_YML}"' EXIT
fi

render_tp2_compose "${RENDER_YML}"

# ---- optional per-profile dir sync (default-off) ----
# SYNC_DIRS entries are "SRC:DEST" pairs. SRC lives on Node0 (usually the
# repo, the source of truth); DEST is staged at the same ABSOLUTE path on
# BOTH nodes before the worker starts. Needed because Node1 does not host
# the repo and this path only ships the rendered compose, so any bind-mount
# source (e.g. the vision lane's hotfix dir) must be provisioned on Node1
# too. Unset => strict no-op (27b/35b/deepseek unchanged).
if [[ -n "${SYNC_DIRS+x}" ]]; then
  for _pair in "${SYNC_DIRS[@]}"; do
    _src="${_pair%%:*}"; _dst="${_pair#*:}"
    echo "== syncing dir ${_src} -> ${_dst} (node0) =="
    mkdir -p "${_dst}"
    rm -rf "${_dst:?}"/*
    cp -a "${_src}"/. "${_dst}"/
    echo "== syncing dir ${_src} -> ${_dst} (node1) =="
    tar -C "$(dirname "${_src}")" -cf - "$(basename "${_src}")" \
      | n1 "mkdir -p '${_dst}' && rm -rf '${_dst:?}'/* && tar -C '${_dst}' -xf - --strip-components=1"
  done
  unset _pair _src _dst
fi

# ---- Node1 headless worker (rank1): ship compose, then up -d worker ----
echo "== launching Node1 headless worker (rank1, compose, profile=${PROFILE}) =="
# Node1 keeps the rendered compose at the SAME absolute path as Node0 when the
# profile declares a stack dir; otherwise fall back to a throwaway /tmp copy.
if [[ -n "${STACK_DIR:-}" ]]; then
  R1_COMPOSE="${COMPOSE_FILE}"
  n1 "mkdir -p '${STACK_DIR}'"
else
  R1_COMPOSE="/tmp/tp2-compose-${PROFILE}.yml"
fi
cat "${RENDER_YML}" | n1 "cat > '${R1_COMPOSE}'"
RANK1_STDIN="$(mktemp)"; chmod 600 "${RANK1_STDIN}"
trap 'rm -f -- "${RANK1_STDIN}"' EXIT
{
  printf 'export SUDO_PASS=%q\n' "$(sudo_pass)"
  printf 'mkdir -p %q\n' "${LOG_BASE}/${PROFILE}"
  printf 'echo "$SUDO_PASS" | sudo -S docker rm -f cluster-node1 >/dev/null 2>&1 || true\n'
  printf 'rc=0\n'
  printf 'echo "$SUDO_PASS" | sudo -S docker compose --env-file /dev/null -f %q up -d worker > %q 2>&1 || rc=$?\n' \
    "${R1_COMPOSE}" "${LOG_BASE}/${PROFILE}/compose-worker.log"
  printf 'echo "DEBUG node1 compose rc=$rc"\n'
  printf 'echo "$SUDO_PASS" | sudo -S docker ps --filter name=cluster-node1 --format "{{.Names}} {{.Status}}" 2>/dev/null || true\n'
  printf 'exit 0\n'
} > "${RANK1_STDIN}"
n1 bash -s < "${RANK1_STDIN}"
rm -f -- "${RANK1_STDIN}"

# ---- Node0 API server (rank0): up -d head ----
echo "== launching Node0 API server (rank0, compose, profile=${PROFILE}) =="
mkdir -p "${LOG_BASE}/${PROFILE}"
sdk docker rm -f cluster-node0 >/dev/null 2>&1 || true
rc=0
sdk docker compose --env-file /dev/null -f "${RENDER_YML}" up -d head > "${LOG_BASE}/${PROFILE}/compose-head.log" 2>&1 || rc=$?
echo "node0 compose rc=$rc"

# ------------------------------------------------------------------
# wait for health
# ------------------------------------------------------------------
echo "== waiting for API health on :${API_PORT} (cold start can take ~10-15 min) =="
begin=$SECONDS
until curl -fsS -m 5 "http://localhost:${API_PORT}/health" >/dev/null 2>&1; do
  if ((SECONDS-begin > ${HEALTH_TIMEOUT:-2400})); then
    echo "ERROR: health timeout (${HEALTH_TIMEOUT:-2400}s)" >&2
    sdk docker logs --tail 60 cluster-node0 2>&1 || true
    exit 1
  fi
  sleep 10
done
echo "$(date '+%F %T') TP2 profile=${PROFILE} READY on :${API_PORT}"
# Background-boot handoff: mark ready so `gb10 wait <profile>` / `gb10 status` can
# report completion even when `gb10 use/start` dispatched the boot detached.
mkdir -p "${REPO_DIR}/state"
echo "$(date '+%F %T')" > "${REPO_DIR}/state/boot-ready.${PROFILE}"
sdk docker ps --filter name=cluster-node --format '{{.Names}} {{.Status}}' 2>/dev/null || true
