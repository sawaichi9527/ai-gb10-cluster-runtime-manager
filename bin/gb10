#!/usr/bin/env bash
# =====================================================================
# gb10 — DGX Spark GB10 2-node cluster (TP2) runtime manager.
#
# Thin convenience layer over scripts/cluster-* (the authoritative TP2
# deployment scripts). Sibling gb10-single manages single-node runtimes.
#
#   gb10 use <profile>        # switch exclusive cluster profile (background)
#   gb10 start <profile>      # same as use
#   gb10 stop                 # cluster-down (kills background boot if active)
#   gb10 restart [profile]    # stop then background up
#   gb10 wait [profile]       # foreground wait for background boot to finish
#   gb10 status               # cluster-status (shows booting/ready)
#   gb10 logs                 # follow cluster-node0 logs
#   gb10 smoke                # cluster-smoke chat test
#   gb10 load                 # cluster-load concurrent load test
#   gb10 list                 # list cluster profiles
#   gb10 verify-models [p]    # SHA256SUMS integrity check on both nodes
#   gb10 doctor               # validate both nodes / image / models
#   gb10 help
# =====================================================================
set -Eeuo pipefail

SELF="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SELF}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
SCRIPTS="${REPO_DIR}/scripts"
STATE="${REPO_DIR}/state"
mkdir -p "${STATE}"

die(){ echo "ERROR: $*" >&2; exit 1; }

usage(){
cat <<'HELP'
gb10 - DGX Spark GB10 2-node cluster (TP2) helper

  gb10 list
  gb10 use <profile>          # 27b (default) | 35b | deepseek | deepseek-vision
  gb10 start <profile>        # same as use (cluster profiles are exclusive)
  gb10 stop                   # stop & remove both cluster containers
  gb10 restart [profile]      # down then background up
  gb10 wait [profile]         # foreground wait for background boot to finish
  gb10 status                 # both nodes, RDMA, KV, health
  gb10 logs                   # follow cluster-node0 logs
  gb10 smoke                  # chat smoke test
  gb10 load                   # concurrent load test
  gb10 verify-models [profile] # SHA256SUMS integrity check (both nodes)
  gb10 doctor                 # validate image/models on both nodes

Boot is backgrounded by default: `use/start` returns immediately,
boot continues in the background.  Poll status with `gb10 status`,
or foreground-wait with `gb10 wait <profile>`.

Auto-protection: `use/start 27b|35b|deepseek|deepseek-vision` frees node1
of any active single-node runtime (gb10-single free node1) before TP2
comes up.  Placeholder profiles (PLACEHOLDER=true, not in the boot set)
short-circuit in gb10 itself: they print "not deployed yet" and never
start a background boot (which would otherwise tear down the live stack).

Single-node runtimes are managed with the sibling command: gb10-single
HELP
}

PROFILES_BY_NAME="27b:35b:deepseek:deepseek-vision"

valid_profile(){
  case ":$PROFILES_BY_NAME:" in
    *":$1:"*) return 0 ;;
    *) return 1 ;;
  esac
}

UP_PROFILE="27b"
down(){ "${SCRIPTS}/cluster-down"; }

# --- background boot helpers ---
_pid_file(){ echo "${STATE}/boot-cluster.${1}.pid"; }
_ready_file(){ echo "${STATE}/boot-ready.${1}"; }

_boot_alive(){
  local pf; pf="$(_pid_file "$1")"
  [[ -f "$pf" ]] || return 1
  local pid; pid="$(cat "$pf")"
  kill -0 "$pid" 2>/dev/null
}

# cluster_boot_alive — is ANY cluster profile background boot active?
cluster_boot_alive(){
  local pf pid
  for pf in "${STATE}"/boot-cluster.*.pid; do
    [[ -f "$pf" ]] || continue
    pid="$(cat "$pf")"
    kill -0 "$pid" 2>/dev/null && return 0
  done
  return 1
}

_kill_boot(){
  local pf pid
  for pf in "${STATE}"/boot-cluster.*.pid; do
    [[ -f "$pf" ]] || continue
    pid="$(cat "$pf")"
    if kill -0 "$pid" 2>/dev/null; then
      echo "Stopping background boot (PID ${pid})..."
      kill "$pid" 2>/dev/null || true
      # wait briefly for the process to exit (cleanup trap removes pidfile)
      local i
      for i in $(seq 1 10); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.5
      done
      kill -9 "$pid" 2>/dev/null || true
      rm -f "$pf"
    else
      rm -f "$pf"
    fi
  done
}

case "${1:-help}" in
  list)
    echo "Cluster (TP2) profiles:"
    echo "  27b  [default]  Qwen3.8 27B (body + DFlash2 drafter)"
    echo "  35b             Qwen3.6 35B-A3B (body + DFlash drafter)"
    echo "  deepseek        DeepSeek-V4-Flash-0731 (fp8 DSpark mainline, 256K)"
    echo "  deepseek-vision  DeepSeek-V4-Flash-Vision-Exp (vLLM multimodal, 32K) [placeholder]"
    ;;
  use|start)
    # Preflight: refuse to deploy from a checkout drifted from upstream.
    # Teardown (stop/down/free) and read-only commands are not guarded.
    "${SCRIPTS}/check-git-sync.sh" --block
    P="${2:-27b}"
    valid_profile "$P" || die "unknown profile: $P"
    case "$P" in
      27b|35b|deepseek|deepseek-vision)
        # prevent concurrent boots (any cluster profile shares port 1234 + GPUs)
        if cluster_boot_alive; then
          pid="$(cat "$(ls -t "${STATE}"/boot-cluster.*.pid 2>/dev/null | head -n1)")"
          die "background boot for another profile already running (PID ${pid})"
        fi
        # launch background boot
        LOG="${STATE}/boot-cluster.${P}.log"
        ( setsid nohup "${SCRIPTS}/gb10-boot-cluster" "$P" </dev/null >"${LOG}" 2>&1 &
          echo $! > "$(_pid_file "$P")" )
        # brief pause to let setsid fork; then confirm PID
        sleep 0.2
        if _boot_alive "$P"; then
          _pid="$(cat "$(_pid_file "$P")")"
          echo "$(date '+%F %T') $P: background boot started (PID ${_pid})"
          echo "  log:  ${LOG}"
          echo "  wait: gb10 wait $P"
          echo "  poll: gb10 status"
        else
          echo "$(date '+%F %T') $P: boot launched (check log: ${LOG})"
        fi
        ;;
      *)
        # Placeholder profile (e.g. deepseek-vision pre-landing): never
        # start a background boot (gb10-boot-cluster would tear down the
        # live stack first). Informational exit 0 — mirrors cluster-up.
        echo "$(date '+%F %T') $P: not deployed yet (placeholder)"
        echo "  flip PLACEHOLDER=false in cluster-profiles.d/${P}.conf + lock IMG_SHA256 first"
        exit 0
        ;;
    esac
    ;;
  wait)
    P="${2:-27b}"
    valid_profile "$P" || die "unknown profile: $P"
    RF="$(_ready_file "$P")"
    PF="$(_pid_file "$P")"
    if [[ -f "$RF" ]]; then
      echo "$(date '+%F %T') $P: READY"
      cat "$RF"
      exit 0
    fi
    if ! _boot_alive "$P"; then
      echo "$(date '+%F %T') $P: no background boot active (use 'gb10 use $P' to start)"
      exit 0
    fi
    echo "$(date '+%F %T') $P: waiting for background boot to complete..."
    _begin=$SECONDS
    while _boot_alive "$P"; do
      if [[ -f "$RF" ]]; then
        echo "$(date '+%F %T') $P: READY"
        cat "$RF"
        exit 0
      fi
      sleep 5
    done
    # process exited — check if ready or failed
    if [[ -f "$RF" ]]; then
      echo "$(date '+%F %T') $P: READY"
      cat "$RF"
    else
      echo "$(date '+%F %T') $P: boot process exited (not ready)"
      echo "  log: ${STATE}/boot-cluster.${P}.log"
      tail -20 "${STATE}/boot-cluster.${P}.log" 2>/dev/null || true
      exit 1
    fi
    ;;
  stop)
    _kill_boot
    down
    ;;
  restart)
    "${SCRIPTS}/check-git-sync.sh" --block
    P="${2:-$(cat "${STATE}/last-cluster-profile" 2>/dev/null || echo 27b)}"
    valid_profile "$P" || die "unknown profile: $P"
    case "$P" in
      27b|35b|deepseek|deepseek-vision)
        _kill_boot
        down
        # launch background boot (same as use|start)
        LOG="${STATE}/boot-cluster.${P}.log"
        ( setsid nohup "${SCRIPTS}/gb10-boot-cluster" "$P" </dev/null >"${LOG}" 2>&1 &
          echo $! > "$(_pid_file "$P")" )
        sleep 0.2
        if _boot_alive "$P"; then
          _pid="$(cat "$(_pid_file "$P")")"
          echo "$(date '+%F %T') $P: background restart started (PID ${_pid})"
          echo "  log:  ${LOG}"
          echo "  wait: gb10 wait $P"
        else
          echo "$(date '+%F %T') $P: restart launched (check log: ${LOG})"
        fi
        ;;
      *)
        # Placeholder profile: no teardown, informational exit 0.
        echo "$(date '+%F %T') $P: not deployed yet (placeholder)"
        echo "  flip PLACEHOLDER=false in cluster-profiles.d/${P}.conf + lock IMG_SHA256 first"
        exit 0
        ;;
    esac
    ;;
  status)
    "${SCRIPTS}/check-git-sync.sh" --warn
    exec "${SCRIPTS}/cluster-status"
    ;;
  logs)
    docker logs -f --tail=150 cluster-node0
    ;;
  smoke)
    exec "${SCRIPTS}/cluster-smoke"
    ;;
  load)
    exec "${SCRIPTS}/cluster-load"
    ;;
  inspect)
    P="${2:-27b}"
    # shellcheck disable=SC1091
    source "${SCRIPTS}/cluster-common.sh"
    inspect_profile "$P"
    ;;
  verify-models)
    P="${2:-27b}"
    valid_profile "$P" || die "unknown profile: $P"
    # shellcheck disable=SC1091
    source "${SCRIPTS}/cluster-common.sh"
    load_profile "$P"
    if [[ "${PROFILE_PLACEHOLDER:-false}" == "true" ]]; then
      echo "$(date '+%F %T') $P: not deployed yet (placeholder); nothing to verify"
      exit 0
    fi
    echo "=== Node0: $(hostname) ==="
    verify_model_checksum "$BODY" 0 || exit 1
    if [[ -n "${DRAF:-}" ]]; then
      verify_model_checksum "$DRAF" 0 || exit 1
    fi
    echo ""
    echo "=== Node1: ${NODE1_SSH_USER}@${NODE1_IP} ==="
    _verify_remote_checksum "$BODY" 0 || exit 1
    if [[ -n "${DRAF:-}" ]]; then
      _verify_remote_checksum "$DRAF" 0 || exit 1
    fi
    echo ""
    echo "PASS: $P — all model checksums OK on both nodes"
    ;;
  doctor)
    ENV_FILE="${HOME}/docker-stacks/config/cluster.env"
    [[ -f "${ENV_FILE}" ]] || die "missing cluster.env (see ~/docker-stacks/config/cluster.env.example)"
    echo "Node0: $(hostname)"
    docker version --format 'node0 docker {{.Server.Version}}' 2>/dev/null || echo "node0 docker: unavailable (sudo?)"
    echo "Node data dirs:"
    ls -d "$HOME"/docker-stacks/{aeon-vllm-omni,models}/models/*/ 2>/dev/null || true
    ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
