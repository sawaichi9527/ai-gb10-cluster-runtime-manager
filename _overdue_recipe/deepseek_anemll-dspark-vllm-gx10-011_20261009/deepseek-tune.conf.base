#!/usr/bin/env bash
# =====================================================================
# deepseek-tune — A/B experiment lane for the DeepSeek V4 Flash 0731
#                 mainline (2026-10-06 campaign).
#
# WHY THIS EXISTS
#   deepseek.conf stays the production mainline and the rollback target.
#   Every single-knob A/B cell runs here instead, so the live profile is
#   never mutated and `gb10 use deepseek` always restores the known-good
#   stack. STACK_DIR/COMPOSE_FILE are per-lane so the tune render never
#   clobbers docker-compose.deepseek.yml.
#
# INVARIANT
#   E0 must render a byte-identical argv to deepseek.conf. Verified with:
#     scripts/cluster-compose-verify deepseek-tune   (vs the live stack)
#
# CELL LOG (edit here, one row per run; keep the knob history visible)
#   E0  2026-10-06  baseline — identical to deepseek.conf (capture=8, greedy,
#                   prefix-caching off, breakable-cudagraph on)
#   E1  pending     CUDAGRAPH_CAPTURE 8 -> 128   (engine default formula
#                   min(numseq*(1+nspec)*2,512) = 8*8*2 = 128)
#   E2  pending     draft_sample_method greedy -> probabilistic (n=7 kept)
#   E3  pending     ENABLE_PREFIX_CACHING false -> true (+ vision hotfix)
#   E4  pending     VLLM_USE_BREAKABLE_CUDAGRAPH 1 -> 0 (re-enable inductor)
#   E5  pending     all winners combined
#
# Evidence backing the cells (verified inside the pinned image, 2026-10-06):
#   * engine boot log shows cudagraph_capture_sizes = [1,2,4,8] => only a
#     single-stream (8 query tokens) decode batch is graphed; an 8-way
#     DSpark batch needs 8*(1+7) = 64. capture cost is tiny: 0.37 GiB / 4 s.
#   * VLLM_USE_BREAKABLE_CUDAGRAPH auto-enables to 1 and therefore sets
#     CompilationMode.NONE — torch.compile/inductor is fully off, and JIT
#     spikes are observed at runtime (W4A16FusedMoeKernel, Triton kernels).
#   * the sibling deepseek-vision.conf (SAME image + digest) already ships
#     capture=56, probabilistic, prefix caching on + dspark-swa-prefix hotfix,
#     reasoning parser and breakable-cudagraph=0.
#
# Image gate: ghcr.io/anemll/dspark-vllm-gx10:0.1.1 (unchanged; no pull-only
#   violation — this lane deliberately keeps the pinned manifest digest).
# =====================================================================
PROFILE_ID="deepseek-tune"
DISPLAY_NAME="DeepSeek V4 Flash 0731 (A/B tune lane, 256K)"
PLACEHOLDER="false"

LAUNCH_STYLE="compose"

# Same node-local stack dir as the mainline lane, DISTINCT compose file so the
# two renders never overwrite each other.
STACK_DIR="${HOME}/docker-stacks/anemll-dspark-vllm-gx10"
COMPOSE_FILE="docker-compose.deepseek-tune.yml"

IMAGE="ghcr.io/anemll/dspark-vllm-gx10:0.1.1"
IMG_SHA256="sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8"

MODELS_BASE="$HOME/docker-stacks/models"
BODY_REL="deepseek-v4-flash-0731-official"
DRAF_REL=""

MAXLEN="262144"
NUMSEQ="8"
BATCHED="16384"
GMU="0.80"

QUANTIZATION="none"
KV_DTYPE="nvfp4_ds_mla"
MOE_BACKEND="flashinfer_b12x"
GRAPH_MODE="FULL_AND_PIECEWISE"
CUDAGRAPH_CAPTURE="8"
ENABLE_CHUNKED_PREFILL="true"
ENABLE_PREFIX_CACHING="false"
DISABLE_CUSTOM_ALL_REDUCE="false"
SHM_SIZE="64g"

# DSpark same-model draft (7 greedy), Weschera contract.
SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":7,"draft_sample_method":"greedy"}'
ENABLE_AUTO_TOOL_CHOICE="true"
TOOL_CALL_PARSER="deepseek_v4"

EXTRA_ARGS=(
  --async-scheduling
  --tokenizer-mode deepseek_v4
  --generation-config vllm
  --enable-flashinfer-autotune
  --distributed-executor-backend mp
)

# NOTE: the mainline deepseek.conf sets VLLM_USE_BREAKABLE_CUDAGRAPH via the
# image's own auto-enable (vllm.py:1128 => 1). E4 adds an explicit "=0" here;
# every other cell leaves this array untouched.
EXTRA_ENV=(
  HF_HUB_OFFLINE=1
  TRANSFORMERS_OFFLINE=1
  VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
  VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
  VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
  ENABLE_VLLM_GB10_PATCH=0
  GB10_HYBRID_NVFP4_M_THRESHOLD=128
  VLLM_USE_FLASHINFER_SAMPLER=1
  VLLM_USE_B12X_MOE=1
  TORCH_CUDA_ARCH_LIST=12.1a
  FLASHINFER_CUDA_ARCH_LIST=12.1a
  CUTE_DSL_ARCH=sm_121a
  FLASHINFER_DISABLE_VERSION_CHECK=1
  TILELANG_CLEANUP_TEMP_FILES=1
  DG_JIT_USE_NVRTC=0
  DG_JIT_NVCC_COMPILER=/usr/local/cuda/bin/nvcc
  VLLM_CACHE_ROOT=/cache/vllm
  FLASHINFER_WORKSPACE_BASE=/cache/vllm/flashinfer
  CUDA_HOME=/usr/local/cuda
  CUDA_PATH=/usr/local/cuda
  CUDAtoolkit_ROOT=/usr/local/cuda
  TP_SOCKET_IFNAME=${NCCL_SOCKET_IFNAME}
  NCCL_NET=IB
  NCCL_IB_DISABLE=0
  NCCL_IB_ROCE_VERSION_NUM=2
  NCCL_IB_ADDR_FAMILY=AF_INET
  NCCL_IB_TIMEOUT=22
  NCCL_IB_RETRY_CNT=7
  NCCL_CROSS_NIC=1
  NCCL_CUMEM_ENABLE=0
  NCCL_IGNORE_CPU_AFFINITY=1
  NCCL_NVLS_ENABLE=0
)

# Shares the mainline lane's JIT/compile cache so a cell change does not pay a
# cold compile it does not have to (identical model + identical kernels).
EXTRA_MOUNTS=(
  -v "${HOME}/.cache/vllm-deepseek:/cache/vllm"
)

# Same FlashInfer autotune cache as the mainline lane; cluster-up clears it on
# both ranks before every boot regardless (rank-keyed cache => deadlock risk).
AUTOTUNE_CACHE_REL=".cache/vllm-deepseek/flashinfer_autotune_cache"
