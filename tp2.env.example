# =====================================================================
# tp2.env.example — DGX Spark GB10 2-node cluster (TP2) variables
# Copy to tp2.env (same dir as this file) on Node0 and edit.
#
#   cp tp2.env.example tp2.env
#
# Secrets: NEVER commit a real VLLM_API_KEY / SUDO_PASS. Provide them
# at runtime via tp2.env (gitignored) or the process environment.
# =====================================================================

# ---- vLLM image (must be identical / same slim on BOTH nodes) ----
export IMG="ghcr.io/aeon-7/aeon-vllm-ultimate:2026-08-24-v0.27.1-omni"

# ---- Nodes (prefer stable interconnect IPs over mgmt LAN IPs) ----
export NODE0_IP="10.0.101.101"      # Node0 interconnect (rank 0)
export NODE1_IP="10.0.101.102"      # Node1 interconnect (rank 1)
export NODE0_MGMT="192.168.23.215"  # mgmt LAN (documentation only)
export NODE1_MGMT="192.168.23.216"  # mgmt LAN (documentation only)

# ---- Cluster control plane (mp backend, no Ray) ----
export MASTER_ADDR="10.0.101.101"
export MASTER_PORT="29501"

# ---- Node1 remote access (Node0 single-side orchestration) ----
export NODE1_SSH_USER="eye"
export NODE1_SSH_KEY="$HOME/.ssh/id_gb10_cluster"

# ---- Interconnect / RoCE v2 ----
export NCCL_SOCKET_IFNAME="enp1s0f0np0"
export NCCL_IB_HCA="rocep1s0f0:1"
export NCCL_IB_GID_INDEX="3"

# ---- API endpoint (Node0 only; Node1 is headless) ----
#
# Unified LLM endpoint convention (all LLM runtimes on the cluster):
#   OpenAI-compatible  http://<mgmt-ip>:1234/v1
#     TP2 cluster .......... 192.168.23.215:1234/v1  (this env, rank0)
#     Node0 single LLM ..... 192.168.23.215:1234/v1  (gb10-single use node0)
#     Node1 single LLM ..... 192.168.23.216:1234/v1  (gb10-single use node1)
#   Image/video runtimes (ComfyUI / MiniMaxH3) are out of scope.
# TP2 and the single-node LLMs share the SAME port 1234, so they are
# mutually exclusive (gb10 use frees both nodes' singles; gb10-single on
# either node tears down TP2 first). Single-node stacks use VLLM_PORT=1234.
export API_PORT="1234"

# ---- Auth for the served model ----
# Unified key shared by TP2 and the single-node LLMs (Node0/Node1
# docker-stacks/aeon-vllm/.env already use the same VLLM_API_KEY value).
# "EMPTY" means no --api-key flag (unauthenticated). To unify auth, set the
# SAME real key here as in the single-node .env files. NEVER commit it.
export VLLM_API_KEY="EMPTY"

# ---- Sudo for docker on both nodes (prompted if unset) ----
# export SUDO_PASS=""
